# ==============================================================================
# Exemplo de variáveis de ambiente.
# Copie para .env e ajuste os valores. O arquivo .env NÃO vai para o Git.
#
#   cp .env.example .env
# ==============================================================================

# ---------------------------------------------------------------- Banco Oracle
# Senha do SYS/SYSTEM do Oracle XE
ORACLE_SYS_PASSWORD=Oracle123

# Schema da aplicação (criado automaticamente pela imagem gvenzl/oracle-xe)
ORACLE_USER=mobilidade
ORACLE_PASSWORD=mobilidade123

# Host/porta/serviço — dentro do Compose o host é o nome do serviço
ORACLE_HOST=oracle-db
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1

# ------------------------------------------------------------------------- JWT
# Precisa ter no mínimo 256 bits (32 caracteres) por causa do algoritmo HS256.
# Em produção, gere um valor novo e guarde como secret, nunca no repositório:
#   openssl rand -base64 48
JWT_SECRET=troque-este-valor-por-um-segredo-gerado-com-openssl-rand-base64-48

# ----------------------------------------------------------------- Aplicação
# Perfil ativo: staging ou prod
SPRING_PROFILES_ACTIVE=prod
PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75

# --------------------------------------------------------------------- Imagem
# Imagem publicada pelo pipeline. Em build local, deixe comentado.
# IMAGE=ghcr.io/SEU-USUARIO/mobilidade-sustentavel:production
